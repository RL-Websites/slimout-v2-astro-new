	description="Send a message to SlimOut's care team and a licensed member will reply within one business day."
>
	<div class="site-header">
		<!-- header section start -->
		<Header />
		<!-- header section end -->
	</div>

	<main>
		<!-- contact support section start -->
		<ContactSupport />
		<!-- contact support section end -->
	</main>

	<div class="site-footer">
		<!-- footer section start -->
		<Footer />
		<!-- footer section end -->
	</div>
</Layout>
