---
import Layout from '../layouts/Layout.astro';
import Logo from '../components/Logo.astro';
import ResetPasswordForm from '../components/ResetPasswordForm.astro';
---

<Layout
	title="Reset Password — SlimOut"
	description="Create a new password for your SlimOut account."
>
	<div class="reset-password-page">
		<div class="reset-password-logo">
			<a href="index.html" class="reset-password-logo-link">
				<Logo width={114} height={42} />
			</a>
		</div>

		<main class="reset-password-main">
			<div class="reset-password-container">
				<!-- reset password section start -->
				<ResetPasswordForm email="you@example.com" loginHref="login.html" />
				<!-- reset password section end -->
			</div>
		</main>
	</div>
</Layout>
