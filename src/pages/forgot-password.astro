---
import Layout from '../layouts/Layout.astro';
import Logo from '../components/Logo.astro';
import ForgotPasswordForm from '../components/ForgotPasswordForm.astro';
---

<Layout
	title="Reset Your Password — SlimOut"
	description="Reset your SlimOut account password to regain access to your account."
>
	<div class="forgot-page">
		<div class="forgot-logo">
			<a href="index.html" class="forgot-logo-link">
				<Logo width={114} height={42} />
			</a>
		</div>

		<main class="forgot-main">
			<div class="forgot-container">
				<!-- forgot section start -->
				<div class="forgot-head">
					<h1 class="forgot-title">
						Reset your <span class="forgot-title-alt">password</span>
					</h1>
					<p class="forgot-lead">Enter your email address and we'll send you a link to reset your password.</p>
				</div>

				<ForgotPasswordForm loginHref="login.html" />

				<div class="forgot-footnote">
					<span class="forgot-footnote-dot"></span>
					Secure &amp; convenient digital care
				</div>
				<!-- forgot section end -->
			</div>
		</main>
	</div>
</Layout>
