---
import AboutAccreditation from "../components/about/AboutAccreditation.astro";
import AboutCta from "../components/about/AboutCta.astro";
import AboutHero from "../components/about/AboutHero.astro";
import AboutSplit from "../components/about/AboutSplit.astro";
import Footer from "../components/common/Footer.astro";
import Header from "../components/common/Header.astro";
import CtaSection from "../components/CtaSection.astro";
import Marquee from "../components/Marquee.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout
	title="About Us — SlimOut"
	description="At SlimOut, we're committed to making high-quality healthcare simple, convenient, and accessible through secure telehealth services."
>
	<div class="site-header">
		<!-- header section start -->
		<Header />
		<!-- header section end -->
	</div>

	<main>
		<!-- about hero section start -->
		<AboutHero />
		<!-- about hero section end -->

		<!-- mission section start -->
		<AboutSplit
			title="Comprehensive"
			titleAlt="Wellness Support"
			titleBreak={true}
			body="Whether you're looking for support with weight management, hormone health, sexual wellness, sleep, longevity, peptide therapy, hair restoration, or overall wellness, our experienced clinical team is here to guide you every step of the way."
			image="about-1.webp"
			alt="Clinician with patient — calm, modern care"
		/>
		<!-- mission section end -->

		<!-- care journey section start -->
		<AboutSplit
			title="Seamless"
			titleAlt="Care Journey"
			body="From online consultation to provider review, prescription fulfillment, and ongoing support, we provide a seamless healthcare experience—all from the comfort of your home. Every treatment plan is reviewed by a licensed healthcare provider to ensure it is appropriate for your individual needs."
			image="about-2.webp"
			alt="Provider portrait — warm, approachable"
			reverse={true}
			tight={true}
		/>
		<!-- care journey section end -->

		<!-- accreditation section start -->
		<AboutAccreditation />
		<!-- accreditation section end -->

		<!-- marquee section start -->
		<Marquee />
		<!-- marquee section end -->

		<!-- cta section start -->
		<CtaSection />
		<!-- cta section end -->
	</main>

	<div class="site-footer">
		<!-- footer section start -->
		<Footer />
		<!-- footer section end -->
	</div>
</Layout>
