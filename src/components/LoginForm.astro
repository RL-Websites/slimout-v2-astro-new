---
import Button from "./utils/Button.astro";

interface Props {
	registerHref?: string;
}

const { registerHref = "register.html" } = Astro.props;
---

<div class="login-card">
	<div class="login-fields">
		<label class="login-field">
			<span class="login-label">Email Address</span>
			<input
				type="email"
				placeholder="you@example.com"
				aria-label="Email address"
				class="login-input"
				data-field="email"
			/>
		</label>
		<label class="login-field">
			<span class="login-label">Password</span>
			<span class="login-password-wrap">
				<input
					type="password"
					placeholder="Your password"
					aria-label="Password"
					class="login-input login-password-input"
					data-field="password"
				/>
				<Button
					variant="link"
					className="login-password-toggle"
					data-password-toggle
					aria-label="Show password"
				>
					<i class="icon-state-on"></i>
				</Button>
			</span>
		</label>
	</div>

	<div class="login-remember-row">
		<Button variant="link" className="login-remember is-checked" data-remember>
			<span class="login-remember-box"></span>
			Keep me signed in
		</Button>
		<a href="forgot-password.html" class="login-forgot">Forgot password?</a>
	</div>

	<div class="login-error is-hidden" data-error></div>

	<Button class="w-full" data-submit>
		Sign In
		<span class="login-submit-arrow">
			<svg
				width="18"
				height="18"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				aria-hidden="true"
			>
				<path d="M5 12h14"></path><path d="M13 6l6 6-6 6"></path>
			</svg>
		</span>
	</Button>

	<div class="login-divider">
		<span class="login-divider-line"></span>
		<span class="login-divider-label">New patient?</span>
		<span class="login-divider-line"></span>
	</div>

	<a href={registerHref} class="login-secondary">Create an account</a>
</div>
