---
import Button from './utils/Button.astro';

const fields = [
	{ key: 'current', label: 'Current password', placeholder: 'Enter your current password' },
	{ key: 'next', label: 'New password', placeholder: 'At least 8 characters' },
	{ key: 'confirm', label: 'Confirm new password', placeholder: 'Re-enter the new password' },
];

const rules = [
	{ key: 'long', text: 'At least 8 characters' },
	{ key: 'mixed', text: 'Letters and numbers' },
	{ key: 'match', text: 'Both new entries match' },
];
---

<section id="top" class="change-password">
	<div class="change-password-inner">
		<a href="account.html" class="change-password-back">
			<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M19 12H5"></path><path d="M11 6l-6 6 6 6"></path>
			</svg>
			Back to account
		</a>

		<div class="change-password-eyebrow">Security</div>
		<h1 class="change-password-title">Change <span class="change-password-title-alt">password</span></h1>
		<p class="change-password-lead">Choose a password you don't use anywhere else. You'll stay signed in on this device.</p>

		<div class="change-password-card" data-change-password-form>
			<div class="change-password-fields">
				{
					fields.map((field) => (
						<label class="change-password-field">
							<span class="change-password-label">{field.label}</span>
							<input
								type="password"
								class="change-password-input"
								placeholder={field.placeholder}
								aria-label={field.label}
								data-field={field.key}
							/>
						</label>
					))
				}
			</div>

			<div class="change-password-rules">
				<div class="change-password-rules-title">Password must include</div>
				<div class="change-password-rule-list">
					{
						rules.map((rule) => (
							<div class="change-password-rule" data-rule={rule.key}>
								<span class="change-password-rule-icon">
									<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
										<path d="M4 12.5l5 5L20 6.5"></path>
									</svg>
								</span>
								<span>{rule.text}</span>
							</div>
						))
					}
				</div>
			</div>

			<div class="change-password-error is-hidden" data-error></div>

			<div class="change-password-actions">
				<Button className="change-password-submit" data-submit>
					Update Password
					<span class="change-password-submit-arrow">
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<path d="M5 12h14"></path><path d="M13 6l6 6-6 6"></path>
						</svg>
					</span>
				</Button>
				<a href="account.html" class="change-password-cancel">Cancel</a>
			</div>
		</div>
	</div>

	<div class="change-password-toast is-hidden" data-toast>
		<span class="change-password-toast-icon">
			<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M4 12.5l5 5L20 6.5"></path>
			</svg>
		</span>
		<span class="change-password-toast-text">Password updated</span>
	</div>
</section>
