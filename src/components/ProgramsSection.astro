---
import { categories } from "../data/categories";
---

<section id="programs" class="programs">
	<div class="programs-header">
		<div>
			<div class="programs-eyebrow">Getting started</div>
			<h2 class="programs-title">
				Explore SlimOut's <span class="programs-title-alt">personalized</span><br />
				care programs
			</h2>
		</div>
		<p class="programs-lead">
			Six provider-led programs. Pick the one that matches what brought you
			here —
			<a href="#cta" class="programs-lead-link">Get Started Today.</a>
		</p>
	</div>
	<div class="programs-grid" data-rvl>
		{
			categories
				.filter((category) => category.slug !== 'weight-loss' && category.slug !== 'sexual-health')
				.map((category) => (
				<a href={`${category.slug}.html`} class="programs-card">
					<span class="programs-card-media">
						<img
							src={category.heroImage}
							alt={category.name}
							class="programs-card-image"
							loading="lazy"
						/>
					</span>
					<span class="programs-card-overlay" />
					<span class="programs-card-footer">
						<span class="programs-card-name">{category.name}</span>
						<span class="programs-card-arrow">
							<i class="icon-arrow-right" />
						</span>
					</span>
				</a>
			))
		}
	</div>
</section>
