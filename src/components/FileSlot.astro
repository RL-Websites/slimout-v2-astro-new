---
import Button from './utils/Button.astro';

// Generic single-file upload slot with a rich preview (image thumbnail or file-type icon),
// re-upload/delete controls, and a hover-to-reveal "Re-upload" overlay. Complements
// <FileDropzone> (a growing multi-file list) for the different shape a document-verification
// flow needs: N independently named slots (e.g. front/back of an ID), each holding exactly one
// file that gets replaced, not appended to. Reports changes via a `file-change` CustomEvent and
// the global file-slot.js registry, same pattern as <FileDropzone>'s files-change/dropzone.js.
interface Props {
	/** Unique id — used to read/set this slot's file via file-slot.js. */
	id: string;
	label: string;
	accept?: string;
	maxMB?: number;
	requiredLabel?: string;
	uploadedLabel?: string;
	emptyTitle?: string;
	emptyHint?: string;
}

const {
	id,
	label,
	accept = '.jpg,.jpeg,.png,.pdf',
	maxMB = 50,
	requiredLabel = 'Required',
	uploadedLabel = 'Uploaded',
	emptyTitle = 'Choose a file or drag it here',
	emptyHint,
} = Astro.props;

const extensions = accept
	.split(',')
	.map((ext) => ext.trim().replace(/^\./, ''))
	.filter(Boolean);
const acceptPattern = extensions.join('|');
const defaultHint = `${extensions.map((ext) => ext.toUpperCase()).join(', ')}, up to ${maxMB} MB`;
---

<div
	class="file-slot"
	data-file-slot={id}
	data-accept-pattern={acceptPattern}
	data-max-mb={maxMB}
	data-required-label={requiredLabel}
	data-uploaded-label={uploadedLabel}
>
	<div class="file-slot-head">
		<span class="file-slot-label">{label}</span>
		<span class="file-slot-state" data-state>{requiredLabel}</span>
	</div>

	<div class="file-slot-empty" data-empty role="button" tabindex="0">
		<span class="file-slot-empty-icon">
			<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M12 16V4"></path><path d="M7 9l5-5 5 5"></path><path d="M4 15v3a2 2 0 002 2h12a2 2 0 002-2v-3"></path>
			</svg>
		</span>
		<div class="file-slot-empty-title">{emptyTitle}</div>
		<div class="file-slot-empty-hint">{emptyHint ?? defaultHint}</div>
	</div>

	<div class="file-slot-filled is-hidden" data-filled>
		<div class="file-slot-preview" data-preview>
			<span class="file-slot-preview-image is-hidden" data-preview-image role="img" aria-label={label}></span>
			<span class="file-slot-preview-doc is-hidden" data-preview-doc>
				<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M14 3H7a2 2 0 00-2 2v14a2 2 0 002 2h10a2 2 0 002-2V8z"></path><path d="M14 3v5h5"></path>
				</svg>
				<span data-preview-ext></span>
			</span>
			<Button variant="link" className="file-slot-reupload" aria-label="Re-upload file" data-reupload-btn>
				<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M12 16V4"></path><path d="M7 9l5-5 5 5"></path><path d="M4 15v3a2 2 0 002 2h12a2 2 0 002-2v-3"></path>
				</svg>
			</Button>
			<Button variant="link" className="file-slot-delete" aria-label="Delete file" data-delete-btn>
				<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M4 7h16"></path><path d="M10 4h4a1 1 0 011 1v2h-6V5a1 1 0 011-1z"></path><path d="M6 7l1 12a2 2 0 002 2h6a2 2 0 002-2l1-12"></path><path d="M10 11v6M14 11v6"></path>
				</svg>
			</Button>
			<Button variant="outline" className="file-slot-reupload-overlay" data-reupload-overlay>
				<span class="file-slot-reupload-pill">
					<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<path d="M20 11a8 8 0 10-2.3 5.7"></path><path d="M20 5v6h-6"></path>
					</svg>
					Re-upload
				</span>
			</Button>
		</div>
		<div class="file-slot-name" data-name></div>
		<div class="file-slot-size" data-size></div>
	</div>

	<input type="file" accept={accept} class="is-hidden" data-file-input aria-hidden="true" tabindex="-1" />
</div>
