---
const ABOUT_US =
	"https://wellnesplusrx-s3.s3.us-east-1.amazonaws.com/slimout/Slimout_v2/Home_Page/About_Us";

const steps = [
	{
		num: "01",
		title: "Share Your History",
		file: "woman-stretching-park+1-converted-from-png.webp",
		body: "Choose a program and complete an intake covering your medical history, health goals and individual needs.",
	},
	{
		num: "02",
		title: "A Provider Reviews It",
		file: "male-doctor-nurse-cooperating-while-examining-electronic-medical-records-patient-doctor-s-office+1-converted-from-png.webp",
		body: "A licensed healthcare provider reviews your intake and, where appropriate, recommends a treatment plan built around you.",
	},
	{
		num: "03",
		title: "Care Arrives",
		file: "ChatGPT+Image+Aug+27%2C+2026%2C+11_28_54+AM+1-converted-from-png.webp",
		body: "Your prescription goes to a trusted pharmacy partner for fulfillment, then ships directly to your doorstep with ongoing support.",
	},
];
---

<section id="how" class="how-it-works" data-move>
	<div class="how-it-works-inner">
		<div class="how-it-works-header">
			<div class="how-it-works-eyebrow">03 — How it works</div>
			<h2 class="how-it-works-title">Understand the process</h2>
		</div>
		<div class="how-it-works-grid" data-move-grid>
			<div class="how-it-works-media" data-move-media>
				{
					steps.map((step, i) => (
						<img
							src={`${ABOUT_US}/${step.file}`}
							alt={`Step ${step.num}: ${step.title}`}
							class="how-it-works-media-img"
							data-move-img={i}
							loading="lazy"
						/>
					))
				}
			</div>
			<div class="how-it-works-steps" data-move-text>
				{
					steps.map((step, i) => (
						<div class="how-it-works-step" data-move-step={i}>
							<div class="how-it-works-step-eyebrow">
								<span class="how-it-works-step-dot" />
								{step.num}
							</div>
							<h3 class="how-it-works-step-title">{step.title}</h3>
							<p class="how-it-works-step-body">{step.body}</p>
						</div>
					))
				}
			</div>
		</div>
	</div>
</section>
