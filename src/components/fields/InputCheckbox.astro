---
interface Props {
	name: string;
	value: string;
	label: string;
	checked?: boolean;
	disabled?: boolean;
	exclusive?: boolean;
}

const { name, value, label, checked = false, disabled = false, exclusive = false } = Astro.props;
---

<label
	class:list={['input-checkbox', disabled && 'input-checkbox--disabled']}
	data-field-option
	data-exclusive={exclusive ? 'true' : undefined}
>
	<input
		class="input-checkbox-input"
		type="checkbox"
		name={name}
		value={value}
		checked={checked}
		disabled={disabled}
	/>
	<span class="input-checkbox-box">
		<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<path d="M5 13l4 4L19 7"></path>
		</svg>
	</span>
	<span class="input-checkbox-label">{label}</span>
</label>
