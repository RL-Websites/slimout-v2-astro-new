---
interface Props {
  subtotal: number;
  shipping: number;
  shipLabel: string;
  total: number;
}

const { subtotal, shipping, shipLabel, total } = Astro.props;

const money = (n: number) => "$" + n.toFixed(2);
---

<div class="cart-summary">
  <div class="cart-summary-coupon">
    <div class="cart-summary-coupon-label">Have a coupon?</div>
    <div class="cart-summary-coupon-row">
      <input
        type="text"
        class="cart-summary-coupon-input"
        placeholder="Coupon code"
        aria-label="Coupon code"
        data-cart-coupon-input
      />
      <button class="theme-btn theme-btn__outline-dark" data-cart-coupon-apply
        >Apply</button
      >
    </div>
    <div class="cart-summary-note">
      <span class="cart-summary-note-icon">
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="9.2"></circle><path d="M12 11v5.4"
          ></path><path d="M12 7.6h.01"></path>
        </svg>
      </span>
      <span class="cart-summary-note-text">
        If you want to purchase the product at no cost,
        <a href="mailto:info@slimout.com" class="cart-summary-note-link"
          >contact the SlimOut team</a
        >.
      </span>
    </div>
  </div>

  <div class="cart-summary-totals">
    <div class="cart-summary-row">
      <span class="cart-summary-label">Subtotal</span>
      <span class="cart-summary-value" data-cart-subtotal
        >{money(subtotal)}</span
      >
    </div>
    <div class="cart-summary-row">
      <span class="cart-summary-label">
        Shipping <span class="cart-summary-shiplabel" data-cart-ship-label
          >({shipLabel})</span
        >
      </span>
      <span class="cart-summary-value" data-cart-ship-cost
        >{money(shipping)}</span
      >
    </div>
    <div class="cart-summary-row cart-summary-row--coupon" data-cart-coupon-row>
      <span class="coupon-label"> Discout </span>
      <div class="coupon-wrap">
        <span class="cart-summary-coupon-chip">
          <span class="cart-summary-coupon-code" data-cart-coupon-code>Free_100</span>
          <span class="cart-summary-coupon-clear" data-cart-coupon-clear
            >&times;</span
          >
        </span>
        <span class="cart-summary-discount" data-cart-discount> -$100</span>
      </div>
    </div>
    <div class="cart-summary-row cart-summary-row--total">
      <span class="cart-summary-total-label">Total</span>
      <span class="cart-summary-total-value" data-cart-total
        >{money(total)}</span
      >
    </div>
  </div>
</div>
