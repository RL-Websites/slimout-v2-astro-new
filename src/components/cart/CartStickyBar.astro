---
interface Props {
	total: number;
	itemCount: string;
	shipLabel: string;
}

const { total, itemCount, shipLabel } = Astro.props;

const money = (n: number) => "$" + n.toFixed(2);
---

<div class="cart-sticky" data-cart-sticky>
	<div class="cart-sticky-total">
		<span class="cart-sticky-total-label">Total</span>
		<span class="cart-sticky-total-value" data-cart-sticky-total
			>{money(total)}</span
		>
	</div>
	<span class="cart-sticky-meta" data-cart-sticky-meta
		>{itemCount} &middot; {shipLabel}</span
	>
	<a href="checkout.html" class="theme-btn theme-btn__primary ml-auto">
		Proceed to Checkout
		<span class="cart-sticky-cta-arrow">
			<svg
				width="18"
				height="18"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				aria-hidden="true"
			>
				<path d="M5 12h14"></path><path d="M13 6l6 6-6 6"></path>
			</svg>
		</span>
	</a>
</div>
