<section id="cta" class="get-started">
	<div class="get-started-panel">
		<span class="get-started-grid-bg"></span>
		<span class="get-started-glow"></span>
		<div class="get-started-content">
			<div class="get-started-eyebrow">10 — Get started</div>
			<h2 class="get-started-title">
				Ready to experience <span class="get-started-title-alt"
					>personalized healthcare?</span
				>
			</h2>
			<p class="get-started-body">Let's take the first step together.</p>
			<div class="get-started-actions">
				<a href="#programs" class="theme-btn theme-btn__primary">
					Explore Treatments
					<span class="get-started-secondary-arrow">
						<svg
							width="18"
							height="18"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<path d="M5 12h14"></path><path d="M13 6l6 6-6 6"></path>
						</svg>
					</span>
				</a>
			</div>
			<div class="get-started-meta">
				<span class="get-started-meta-dot"></span>
				Licensed providers &middot; Secure digital care &middot; Delivery to your
				door
			</div>
		</div>
	</div>
</section>
