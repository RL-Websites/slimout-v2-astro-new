---

---

<section id="cta" class="get-started">
	<div class="get-started-panel" data-curtain>
		<div class="get-started-media" data-parallax data-parallax-strength="0.12">
			<img
				src="https://wellnesplusrx-s3.s3.us-east-1.amazonaws.com/slimout/Slimout_v2/Home_Page/About_Us/ChatGPT+Image+Aug+21%2C+2026%2C+03_53_14+PM.webp"
				alt="Patient enjoying everyday life after starting personalized care"
				class="get-started-image"
				loading="lazy"
			/>
		</div>
		<span class="get-started-scrim"></span>
		<span class="get-started-grid-bg"></span>
		<span class="get-started-glow"></span>
		<div class="get-started-content">
			<div class="get-started-eyebrow" data-reveal data-reveal-delay="0">09 — Get started</div>
			<h2 class="get-started-title" data-reveal data-reveal-delay="80">
				Ready to experience <span class="get-started-title-alt"
					>personalized healthcare?</span
				>
			</h2>
			<p class="get-started-body" data-reveal data-reveal-delay="160">Let's take the first step together.</p>
			<div class="get-started-actions">
				<a href="#programs" class="theme-btn theme-btn__primary">
					Explore Treatments
					<span class="get-started-secondary-arrow">
						<svg
							width="18"
							height="18"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<path d="M5 12h14"></path><path d="M13 6l6 6-6 6"></path>
						</svg>
					</span>
				</a>
			</div>
			<div class="get-started-meta" data-reveal data-reveal-delay="220">
				<span class="get-started-meta-dot"></span>
				Licensed providers &middot; Secure digital care &middot; Delivery to your
				door
			</div>
		</div>
	</div>
</section>
