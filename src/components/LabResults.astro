---
import Button from "./utils/Button.astro";

import LabOptionModal from "./LabOptionModal.astro";
import LabUploadModal from "./LabUploadModal.astro";
import LabWarnModal from "./LabWarnModal.astro";
import StickyNav from "./StickyNav.astro";

const panels = [
	"Prostate-Specific Ag",
	"Testosterone, Free, Direct",
	"CBC With Differential/Platelet",
	"CBC/Diff Ambiguous Default",
	"Estradiol, Sensitive",
];
---

<section id="top" class="lab-results">
	<div class="lab-results-inner">
		<h1 class="lab-results-title"
			>Select how you would like to provide <span class="lab-results-title-alt"
				>lab results</span
			></h1
		>

		<div class="lab-results-card">
			<div class="lab-results-tests">
				<h2 class="lab-results-heading">Required lab tests</h2>
				<p class="lab-results-tests-lead"
					>The tests listed below are required for this program and will be
					included in the lab requisition provided by SlimOut. The patient may
					take this requisition to a nearby laboratory to complete the required
					blood work.</p
				>
				<div class="lab-results-panels">
					{
						panels.map((panel) => (
							<span class="lab-results-panel-chip">{panel}</span>
						))
					}
				</div>
			</div>

			<div class="lab-results-choice">
				<h2 class="lab-results-heading lab-results-heading-pretty"
					>Choose how lab work would be submitted for this order</h2
				>
				<p class="lab-results-choice-lead"
					>Select one of the options below to proceed with the required blood
					tests.</p
				>

				<div class="lab-results-empty" data-lab-empty role="button">
					<span class="lab-results-empty-icon">
						<svg
							width="19"
							height="19"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="1.8"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<path d="M12 5v14"></path><path d="M5 12h14"></path>
						</svg>
					</span>
					<span class="lab-results-empty-body">
						<span class="lab-results-empty-title">No lab option selected</span>
						<span class="lab-results-empty-text"
							>Choose how you want to complete your lab work.</span
						>
					</span>
					<span class="lab-results-empty-cta">
						Choose lab option
						<svg
							width="17"
							height="17"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<path d="M5 12h14"></path><path d="M13 6l6 6-6 6"></path>
						</svg>
					</span>
				</div>

				<div class="lab-results-filled is-hidden" data-lab-filled>
					<div class="lab-results-filled-top">
						<span class="lab-results-filled-icon">
							<svg
								width="19"
								height="19"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2.4"
								stroke-linecap="round"
								stroke-linejoin="round"
								aria-hidden="true"
							>
								<path d="M4 12.5l5 5L20 6.5"></path>
							</svg>
						</span>
						<span class="lab-results-filled-body">
							<span class="lab-results-filled-label">Your lab option</span>
							<span class="lab-results-filled-value" data-lab-chosen-label
							></span>
						</span>
						<Button
							variant="outline"
							className="lab-results-filled-action"
							data-lab-upload-btn
							data-modal-open="lab-upload-modal"
						>
							<svg
								width="16"
								height="16"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="1.8"
								stroke-linecap="round"
								stroke-linejoin="round"
								aria-hidden="true"
							>
								<path d="M12 16V4"></path><path d="M7 9l5-5 5 5"></path><path
									d="M4 15v3a2 2 0 002 2h12a2 2 0 002-2v-3"></path>
							</svg>
							<span data-lab-upload-btn-label>Upload Report</span>
						</Button>
						<Button
							variant="link"
							className="lab-results-filled-action"
							data-lab-change-btn
							text="Change"
						/>
					</div>
					<p class="lab-results-filled-followup" data-lab-followup></p>

					<div class="lab-results-files is-hidden" data-lab-files-block>
						<span class="lab-results-files-label">Uploaded files</span>
						<div class="lab-results-file-list" data-lab-files-list></div>
					</div>
				</div>
			</div>
		</div>

		<div class="lab-results-notice">
			<span class="lab-results-notice-icon">
				<svg
					width="18"
					height="18"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="1.8"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<circle cx="12" cy="12" r="9.2"></circle><path d="M12 11v5.4"
					></path><path d="M12 7.6h.01"></path>
				</svg>
			</span>
			<span class="lab-results-notice-text"
				>Without these lab results, our doctors cannot proceed with your
				prescription.</span
			>
		</div>
	</div>
</section>

<StickyNav maxWidth={980}>
	<span slot="status" data-lab-status
		>Choose how you want to complete your lab work.</span
	>
	<a slot="back" href="cart.html" class="sticky-nav-back">Back</a>
	<Button slot="next" className="sticky-nav-next" data-lab-next>
		Next
		<span class="sticky-nav-next-arrow">
			<svg
				width="18"
				height="18"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				aria-hidden="true"
			>
				<path d="M5 12h14"></path><path d="M13 6l6 6-6 6"></path>
			</svg>
		</span>
	</Button>
</StickyNav>

<LabOptionModal />
<LabWarnModal />
<LabUploadModal />
