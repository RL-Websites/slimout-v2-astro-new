---
// "Sexual Health" — design's `data-spk` section (after the Explore section, before How It
// Works): full-bleed background video with a two-layer gradient scrim, intro copy + a glass
// showcase card (SVG ring + a continuously spinning product image — no scroll-jacking, per the
// design's own comment), and a horizontal product rail. Reuses ProductCard/ProductDetailModal
// and the category's real product data, same as the weight-loss rail in ExploreSection.
import { getCategory } from "../data/categories";
import ProductCard from "./common/ProductCard.astro";
import ProductDetailModal from "./ProductDetailModal.astro";

const MEDICINE =
	"https://wellnesplusrx-s3.s3.us-east-1.amazonaws.com/slimout/Slimout_v2/Medicine";
const sexualHealth = getCategory("sexual-health")!;
---

<section class="sexual-health">
	<div class="sexual-health-media">
		<video
			class="sexual-health-img"
			autoplay
			muted
			loop
			playsinline
			webkit-playsinline
		>
			<source
				src="https://wellnesplusrx-s3.s3.us-east-1.amazonaws.com/slimout/Slimout_v2/Home_Page/Category/0_Couple_Beach_1280x720.mp4"
				type="video/mp4"
			/>
		</video>
	</div>
	<span class="sexual-health-scrim" aria-hidden="true"></span>

	<div class="sexual-health-row">
		<div class="sexual-health-content" data-reveal>
			<div class="sexual-health-eyebrow">Sexual health</div>
			<h2 class="sexual-health-title">
				Better intimacy, without<br />the awkward appointment
			</h2>
			<p class="sexual-health-body">
				A private online consultation, treatment options reviewed by a licensed
				provider, and refills that arrive at your door.
			</p>
			<a href={`${sexualHealth.slug}.html`} class="theme-btn theme-btn__white">
				View All
			</a>
		</div>

		<div class="sexual-health-stat" data-reveal data-reveal-delay="120">
			<div class="sexual-health-stat-ring-wrap">
				<svg
					class="sexual-health-stat-ring"
					viewBox="0 0 200 200"
					aria-hidden="true"
				>
					<circle
						cx="100"
						cy="100"
						r="82"
						fill="none"
						stroke-width="2.4"
						stroke-linecap="round"
						stroke-dasharray="515"
						stroke-dashoffset="515"
						transform="rotate(-90 100 100)"
					></circle>
				</svg>
				<div class="sexual-health-stat-spin" data-spk-spin>
					<img
						src={`${MEDICINE}/ChatGPT+Image+Aug+21%2C+2026%2C+09_20_19+AM+1.webp`}
						alt="SlimOut tablet"
						class="sexual-health-stat-img"
						loading="lazy"
					/>
				</div>
			</div>
			<div class="sexual-health-stat-note">Reviewed by a licensed provider</div>
			<div class="sexual-health-stat-headline">Discreet delivery</div>
		</div>
	</div>

	<div class="sexual-health-rail" data-rail>
		<div class="sexual-health-rail-track" data-rail-track>
			{
				sexualHealth.products.map((product) => (
					<div class="sexual-health-rail-item">
						<ProductCard
							product={product}
							showAddToCart
							modalId={`spk-modal-${product.slot}`}
							onDark
						/>
					</div>
				))
			}
		</div>
	</div>
</section>

{
	sexualHealth.products.map((product) => (
		<ProductDetailModal
			product={product}
			modalId={`spk-modal-${product.slot}`}
			recommendedItems={sexualHealth.recommended}
		/>
	))
}
