---
import Button from './utils/Button.astro';

import Modal from './Modal.astro';

// Generic "heads up before you continue" dialog — a caution icon, title, message, an optional
// hint callout, and a cancel/confirm action pair. Content is fully prop-driven so any page can
// reuse it (e.g. quiz eligibility warnings, destructive-but-allowed actions elsewhere) without
// a page-specific modal component. Wire it up with openModal/closeModal (the shared modal
// mechanics in common.js)
// — the confirm button only carries `data-warning-confirm`,
// so the consuming page's own script decides what "continue anyway" means.
interface Props {
	id?: string;
	title: string;
	message: string;
	messageStrong?: string;
	hintTitle?: string;
	hintText?: string;
	confirmText?: string;
	cancelText?: string;
}

const {
	id = 'warning-modal',
	title,
	message,
	messageStrong,
	hintTitle,
	hintText,
	confirmText = 'Continue Anyway',
	cancelText = 'Go Back',
} = Astro.props;
---

<Modal id={id} size="sm" labelledBy={`${id}-title`}>
	<div class="warning-modal-body">
		<Button variant="link" className="warning-modal-close" data-modal-close aria-label="Close">
			<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
				<path d="M6 6l12 12M18 6L6 18"></path>
			</svg>
		</Button>

		<span class="warning-modal-icon">
			<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M12 3.4L1.9 20.6h20.2z"></path><path d="M12 9.6v5"></path><path d="M12 17.6h.01"></path>
			</svg>
		</span>

		<h3 class="warning-modal-title" id={`${id}-title`}>{title}</h3>
		<p class="warning-modal-lead">
			{messageStrong && <strong class="warning-modal-lead-strong">{messageStrong} </strong>}
			{message}
		</p>

		{hintTitle && hintText && (
			<div class="warning-modal-hint">
				<div class="warning-modal-hint-head">
					<span class="warning-modal-hint-icon">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
							<circle cx="12" cy="12" r="9.2"></circle><path d="M12 11v5.4"></path><path d="M12 7.6h.01"></path>
						</svg>
					</span>
					<span class="warning-modal-hint-title">{hintTitle}</span>
				</div>
				<p class="warning-modal-hint-text">{hintText}</p>
			</div>
		)}

		<div class="warning-modal-actions">
			<Button variant="outline" className="warning-modal-cancel" data-modal-close text={cancelText} />
			<Button className="warning-modal-confirm" data-warning-confirm text={confirmText} />
		</div>
	</div>
</Modal>
