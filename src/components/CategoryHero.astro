---
import { categories } from '../data/categories';

interface Props {
	category: string;
	slug: string;
	blurb: string;
}

const { category, slug, blurb } = Astro.props;

const words = category.trim().split(' ');
const lead = words.slice(0, -1).join(' ');
const accent = words.slice(-1).join(' ');
---

<section id="top" class="category-hero">
	<div class="category-hero-pills">
		{
			categories.map((c) => (
				<a
					href={`${c.slug}.html`}
					class:list={['category-hero-pill', { 'is-active': c.slug === slug }]}
				>
					{c.name}
				</a>
			))
		}
	</div>
	<div class="category-hero-crumbs">
		<a href="index.html#programs" class="category-hero-crumb-link">Treatments</a>
		<span class="category-hero-crumb-sep">/</span>
		<span class="category-hero-crumb-current">{category}</span>
	</div>
	<h1 class="category-hero-title">
		{lead && `${lead} `}<em class="category-hero-title-accent">{accent}</em>
	</h1>
	<p class="category-hero-blurb">{blurb}</p>
</section>
