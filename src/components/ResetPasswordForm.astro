---
import Button from './utils/Button.astro';

interface Props {
	email?: string;
	loginHref?: string;
}

const { email = 'you@example.com', loginHref = 'login.html' } = Astro.props;
---

<div data-reset-password-state="form">
	<div class="reset-password-head">
		<h1 class="reset-password-title">Reset <span class="reset-password-title-alt">password</span></h1>
		<p class="reset-password-lead">Create a new password for your account.</p>
	</div>

	<div class="reset-password-card">
		<div class="reset-password-field">
			<span class="reset-password-label">Email Address</span>
			<span class="reset-password-static">{email}</span>
		</div>

		<label class="reset-password-field">
			<span class="reset-password-label">New Password</span>
			<span class="reset-password-password-wrap">
				<input
					type="password"
					placeholder="Enter new password"
					aria-label="New password"
					class="reset-password-input reset-password-password-input"
					data-field="password"
				/>
				<Button variant="link" className="reset-password-password-toggle" data-password-toggle="password" aria-label="Show password">
					<svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle>
					</svg>
				</Button>
			</span>
		</label>

		<label class="reset-password-field">
			<span class="reset-password-label">Confirm New Password</span>
			<span class="reset-password-password-wrap">
				<input
					type="password"
					placeholder="Re-enter new password"
					aria-label="Confirm new password"
					class="reset-password-input reset-password-password-input"
					data-field="confirm"
				/>
				<Button variant="link" className="reset-password-password-toggle" data-password-toggle="confirm" aria-label="Show password">
					<svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle>
					</svg>
				</Button>
			</span>
		</label>

		<div class="reset-password-requirements">
			<span class="reset-password-requirement" data-requirement="length">
				<span class="reset-password-requirement-dot"></span>At least 8 characters
			</span>
			<span class="reset-password-requirement" data-requirement="mix">
				<span class="reset-password-requirement-dot"></span>Letters &amp; numbers
			</span>
		</div>

		<div class="reset-password-error is-hidden" data-error></div>

		<Button className="reset-password-submit" data-submit>
			<span data-submit-label>Reset Password</span>
			<span class="reset-password-submit-arrow">
				<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M5 12h14"></path><path d="M13 6l6 6-6 6"></path>
				</svg>
			</span>
		</Button>

		<a href={loginHref} class="reset-password-back">Back to Sign In</a>
	</div>
</div>

<div class="is-hidden" data-reset-password-state="done">
	<div class="reset-password-head">
		<span class="reset-password-done-icon">
			<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M4 12.5l5 5L20 6.5"></path>
			</svg>
		</span>
		<h1 class="reset-password-title">Password <span class="reset-password-title-alt">reset</span></h1>
		<p class="reset-password-lead">Your password has been reset successfully. You can now sign in with your new password.</p>
	</div>

	<div class="reset-password-card-done">
		<Button href={loginHref} className="reset-password-submit is-enabled">
			Go to Login
			<span class="reset-password-submit-arrow">
				<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M5 12h14"></path><path d="M13 6l6 6-6 6"></path>
				</svg>
			</span>
		</Button>
	</div>
</div>
