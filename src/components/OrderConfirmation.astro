---
import CartTimeline from "./cart/CartTimeline.astro";

const PRODUCT_IMAGE =
	"Themes/Thrivewellrx.Theme.SlimoutV2/assets/img/product-demo.png";

const heroFields = [
	{ label: "Transaction ID", value: "#SL-48213" },
	{ label: "Order Date", value: "August 17, 2026" },
	{ label: "Items", value: "2 items" },
	{ label: "Order Total", value: "$948.00" },
];

const products = [
	{
		slot: "oc-p1",
		name: "Tirzemelt 20",
		program: "3 Month Program",
		qty: 1,
		price: "$299.00",
		image: PRODUCT_IMAGE,
	},
	{
		slot: "oc-p2",
		name: "Tirzemelt 20",
		program: "1 Month Program",
		qty: 2,
		price: "$598.00",
		image: PRODUCT_IMAGE,
	},
];

const summaryLines = [
	{ label: "Subtotal", value: "$897.00" },
	{ label: "Shipping", value: "$51.00" },
];

const orderTotal = "$948.00";

const nextSteps = [
	"We've emailed you a link to complete your intake form. Please submit it to begin processing your order.",
	"Your order is sent directly to our licensed physician for review.",
	"Once approved, it will be forwarded to the pharmacy for preparation.",
	"Our fulfillment team will then package your product.",
	"Once shipped, you'll receive a shipping confirmation email with tracking details.",
];

const customerInfo = [
	{ label: "Name", value: "Jordan Rivera" },
	{ label: "Shipping Address", value: "128 Maple Street" },
	{ label: "Shipping City", value: "Austin" },
	{ label: "Shipping State", value: "TX" },
	{ label: "Shipping Zipcode", value: "78701" },
];
---

<section id="top" class="order-confirmation">
	<div class="order-confirmation-inner">
		<CartTimeline active={3} />

		<div class="order-confirmation-hero">
			<svg
				class="order-confirmation-hero-decor"
				viewBox="0 0 600 400"
				preserveAspectRatio="none"
				aria-hidden="true"
			>
				<g fill="none" stroke="rgba(187,204,70,0.3)" stroke-width="1.1">
					<ellipse
						cx="330"
						cy="150"
						rx="230"
						ry="150"
						transform="rotate(-22 330 150)"></ellipse>
					<ellipse
						cx="360"
						cy="180"
						rx="180"
						ry="120"
						transform="rotate(-14 360 180)"></ellipse>
					<ellipse
						cx="300"
						cy="120"
						rx="140"
						ry="96"
						transform="rotate(-30 300 120)"></ellipse>
				</g>
			</svg>

			<div class="order-confirmation-hero-intro">
				<h1 class="order-confirmation-hero-title">
					Thank you for your <span class="order-confirmation-hero-title-alt"
						>order</span
					>
				</h1>
				<p class="order-confirmation-hero-lead">
					Your order is confirmed and on its way to a licensed provider for
					review. No additional action is required right now.
				</p>
			</div>

			<div class="order-confirmation-panel">
				<button
					id="order-details-toggle"
					type="button"
					class="theme-btn theme-btn__link order-confirmation-panel-summary"
					aria-expanded="false"
					aria-controls="order-details"
				>
					<span class="order-confirmation-panel-fields">
						{
							heroFields.map((field) => (
								<span class="order-confirmation-panel-field">
									<span class="order-confirmation-panel-field-label">
										{field.label}
									</span>
									<span class="order-confirmation-panel-field-value">
										{field.value}
									</span>
								</span>
							))
						}
						<span class="order-confirmation-panel-pill">
							View Details
							<span
								id="order-details-chevron"
								class="order-confirmation-panel-pill-icon"
							>
								<svg
									width="16"
									height="16"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
									aria-hidden="true"
								>
									<path d="M6 9l6 6 6-6"></path>
								</svg>
							</span>
						</span>
					</span>
				</button>

				<div id="order-details" class="order-confirmation-details">
					<div class="order-confirmation-details-inner">
						<div class="order-confirmation-details-label">Product details</div>
						<div class="order-confirmation-product-list">
							{
								products.map((product) => (
									<div class="order-confirmation-product-row">
										<div class="order-confirmation-product-image">
											<img
												src={product.image}
												alt={product.name}
												loading="lazy"
											/>
										</div>
										<div class="order-confirmation-product-info">
											<div class="order-confirmation-product-name">
												{product.name}
											</div>
											<div class="order-confirmation-product-program">
												{product.program}
											</div>
										</div>
										<div class="order-confirmation-product-qty">
											Qty {product.qty}
										</div>
										<div class="order-confirmation-product-price">
											{product.price}
										</div>
									</div>
								))
							}
						</div>

						<div class="order-confirmation-details-label">Order summary</div>
						<div class="order-confirmation-summary-list">
							{
								summaryLines.map((line) => (
									<div class="order-confirmation-summary-line">
										<span class="order-confirmation-summary-line-label">
											{line.label}
										</span>
										<span class="order-confirmation-summary-line-value">
											{line.value}
										</span>
									</div>
								))
							}
							<div class="order-confirmation-summary-total">
								<span class="order-confirmation-summary-total-label"
									>Order total</span
								>
								<span class="order-confirmation-summary-total-value"
									>{orderTotal}</span
								>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>

		<div class="order-confirmation-grid">
			<div class="order-confirmation-next">
				<h2 class="order-confirmation-card-title">What happens next</h2>
				<div class="order-confirmation-next-list">
					{
						nextSteps.map((step, index) => (
							<div class="order-confirmation-next-step">
								<span class="order-confirmation-next-step-marker">
									{index < nextSteps.length - 1 && (
										<span class="order-confirmation-next-step-line" />
									)}
									<span class="order-confirmation-next-step-num">
										{index + 1}
									</span>
								</span>
								<span class="order-confirmation-next-step-text">{step}</span>
							</div>
						))
					}
				</div>
				<a href="#" class="order-confirmation-next-cta">
					Submit Intake Form
					<span class="order-confirmation-next-cta-arrow">
						<svg
							width="18"
							height="18"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<path d="M5 12h14"></path><path d="M13 6l6 6-6 6"></path>
						</svg>
					</span>
				</a>
			</div>

			<div class="order-confirmation-side">
				<div class="order-confirmation-card">
					<h2 class="order-confirmation-card-title">Customer Information</h2>
					<div class="order-confirmation-customer-grid">
						{
							customerInfo.map((field) => (
								<div class="order-confirmation-customer-field">
									<div class="order-confirmation-customer-field-label">
										{field.label}
									</div>
									<div class="order-confirmation-customer-field-value">
										{field.value}
									</div>
								</div>
							))
						}
					</div>
				</div>
				<div class="order-confirmation-card order-confirmation-card--grow">
					<h2 class="order-confirmation-card-title">Good to know</h2>
					<div class="order-confirmation-note-list">
						<div class="order-confirmation-note">
							<span class="order-confirmation-note-dot"></span>
							<span>These products are prescription items.</span>
						</div>
						<div class="order-confirmation-note">
							<span class="order-confirmation-note-dot"></span>
							<span>Doctor consultation and medical review are required.</span>
						</div>
						<div class="order-confirmation-note">
							<span class="order-confirmation-note-dot"></span>
							<span
								>Please ensure your shipping address and contact details are
								correct to avoid delays.</span
							>
						</div>
					</div>
					<div class="order-confirmation-contact">
						Questions? Call <a
							href="tel:8336543556"
							class="order-confirmation-contact-link">(833) 654-3556</a
						> or email <a
							href="mailto:info@slimout.com"
							class="order-confirmation-contact-link">info@slimout.com</a
						>.
					</div>
				</div>
			</div>
		</div>

		<div class="order-confirmation-actions">
			<a href="index.html#programs" class="order-confirmation-actions-primary">
				Continue Shopping
				<span class="order-confirmation-actions-primary-arrow">
					<svg
						width="18"
						height="18"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
					>
						<path d="M5 12h14"></path><path d="M13 6l6 6-6 6"></path>
					</svg>
				</span>
			</a>
			<a href="index.html" class="order-confirmation-actions-secondary"
				>Back to Home</a
			>
		</div>
	</div>
</section>
