---
const ASSET_BASE = "Themes/Thrivewellrx.Theme.SlimoutV2/assets/img";
---

<section id="top" class="about-hero">
	<div class="about-hero-panel">
		<div class="about-hero-media">
			<img
				src={`${ASSET_BASE}/about-banner.webp`}
				alt="SlimOut provider team"
				class="about-hero-image"
			/>
		</div>
		<div class="about-hero-overlay"></div>
		<div class="about-hero-content">
			<div class="about-hero-eyebrow">About SlimOut</div>
			<h1 class="about-hero-title">
				Personalized <span class="about-hero-title-alt"
					>Healthcare Solutions</span
				>
			</h1>
			<p class="about-hero-lead">
				At SlimOut, we're committed to making high-quality healthcare simple,
				convenient, and accessible through secure telehealth services. Our
				provider-guided programs are designed to help you achieve your health
				and wellness goals with personalized care and evidence-based treatment
				options.
			</p>
		</div>
	</div>
</section>
