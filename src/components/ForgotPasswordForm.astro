---
import Button from './utils/Button.astro';

interface Props {
	loginHref?: string;
}

const { loginHref = 'login.html' } = Astro.props;
---

<div class="forgot-card">
	<div class="forgot-fields">
		<label class="forgot-field">
			<span class="forgot-label">Email Address</span>
			<input
				type="email"
				placeholder="you@example.com"
				aria-label="Email address"
				class="forgot-input"
				data-field="email"
			/>
		</label>
	</div>

	<div class="forgot-error is-hidden" data-error></div>

	<Button className="forgot-submit" data-submit>
		Send Reset Link
		<span class="forgot-submit-arrow">
			<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M5 12h14"></path><path d="M13 6l6 6-6 6"></path>
			</svg>
		</span>
	</Button>
<!-- 
	<div class="forgot-divider">
		<span class="forgot-divider-line"></span>
		<span class="forgot-divider-label">Remember your password?</span>
		<span class="forgot-divider-line"></span>
	</div> -->

	<a href={loginHref} class="forgot-secondary">Back to Sign In</a>
	<p class="forgot-create">First-time visitor?<a href={loginHref} class="forgot-actext">Create an account</a></p>
</div>
