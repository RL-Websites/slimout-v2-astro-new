---
import Button from './utils/Button.astro';

import Modal from './Modal.astro';

// Generic yes/no confirmation dialog — icon, title, message, and a cancel/confirm action pair.
// Content and tone are fully prop-driven so any page can reuse it (leaving a multi-step flow,
// discarding changes, destructive actions, ...) without a page-specific modal component. Wire
// it up with openModal/closeModal (the shared modal mechanics in common.js) —
// the confirm button only carries `data-confirmation-confirm`, so the consuming page's own
// script decides what confirming actually does.
interface Props {
	id?: string;
	title: string;
	message: string;
	confirmText?: string;
	cancelText?: string;
	tone?: 'neutral' | 'danger';
}

const {
	id = 'confirmation-modal',
	title,
	message,
	confirmText = 'Confirm',
	cancelText = 'Cancel',
	tone = 'neutral',
} = Astro.props;
---

<Modal id={id} size="sm" labelledBy={`${id}-title`}>
	<div class="confirmation-modal-body">
		<Button variant="link" className="confirmation-modal-close" data-modal-close aria-label="Close">
			<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
				<path d="M6 6l12 12M18 6L6 18"></path>
			</svg>
		</Button>

		<span class:list={['confirmation-modal-icon', tone === 'danger' && 'confirmation-modal-icon--danger']}>
			<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<circle cx="12" cy="12" r="9.2"></circle><path d="M12 7.6v5"></path><path d="M12 16.4h.01"></path>
			</svg>
		</span>

		<h3 class="confirmation-modal-title" id={`${id}-title`}>{title}</h3>
		<p class="confirmation-modal-lead">{message}</p>

		<div class="confirmation-modal-actions">
			<Button variant="outline" className="confirmation-modal-cancel" data-modal-close text={cancelText} />
			<Button
				className={`confirmation-modal-confirm${tone === 'danger' ? ' confirmation-modal-confirm--danger' : ''}`}
				data-confirmation-confirm
				text={confirmText}
			/>
		</div>
	</div>
</Modal>
