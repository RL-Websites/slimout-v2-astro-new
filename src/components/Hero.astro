---

---

<section id="top" class="hero">
	<div class="hero-media" data-hero-parallax>
		<video
			class="hero-image"
			autoplay
			muted
			loop
			playsinline
			webkit-playsinline
		>
			<source
				src="https://wellnesplusrx-s3.s3.us-east-1.amazonaws.com/slimout/Slimout_v2/Home_Page/Hero_Section/0_Man_Woman_1280x672.mp4"
				type="video/mp4"
			/>
		</video>
	</div>

	<div class="hero-overlay"></div>
	<div class="hero-content">
		<div class="hero-grid">
			<h1 class="hero-title" data-reveal data-reveal-delay="80">
				Personalized <br />Healthcare. <span class="hero-title-alt"
					>Simplified.</span
				>
			</h1>
			<div class="hero-body" data-reveal data-reveal-delay="180">
				<p class="hero-lead">
					SlimOut connects patients with licensed healthcare providers through a
					seamless telehealth experience—making it easier to access personalized
					treatments, ongoing care, and wellness programs, all from the comfort of
					home.
				</p>
				<div class="hero-actions">
					<a href="#programs" class="theme-btn theme-btn__white">
						Explore Treatment
						<span class="theme-btn__arrow">
							<svg
								width="18"
								height="18"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
								aria-hidden="true"
							>
								<path d="M5 12h14"></path><path d="M13 6l6 6-6 6"></path>
							</svg>
						</span>
					</a>
				</div>
			</div>
		</div>
	</div>
	<div class="hero-scroll">
		<span class="hero-scroll-label">Scroll</span>
		<span class="hero-scroll-track">
			<span class="hero-scroll-dot"></span>
		</span>
	</div>
</section>
