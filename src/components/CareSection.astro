---

<section id="care" class="care" data-expand>
	<div class="care-viewport">
		<div class="care-frame" data-expand-frame>
			<img
				src="https://wellnesplusrx-s3.s3.us-east-1.amazonaws.com/slimout/Slimout_v2/Home_Page/About_Us/new.webp"
				alt="Care designed around you"
				class="care-image"
				loading="lazy"
			/>
			<div class="care-scrim" data-expand-scrim></div>
		</div>
		<div class="care-content" data-expand-text>
			<div class="care-eyebrow">07 — Provider-guided care</div>
			<h2 class="care-title">Care designed around you</h2>
			<p class="care-body">
				Every patient is different—and so is every treatment plan. Our
				personalized approach allows licensed healthcare providers to recommend
				therapies based on your medical history, health goals, and individual
				needs, helping you achieve better outcomes with confidence.
			</p>
			<a href="#programs" class="care-cta">
				Explore Treatments
				<span class="care-cta-arrow">
					<svg
						width="18"
						height="18"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
					>
						<path d="M5 12h14"></path><path d="M13 6l6 6-6 6"></path>
					</svg>
				</span>
			</a>
		</div>
	</div>
</section>
