---
interface Product {
	name: string;
	desc: string;
	price: string;
	priceLabel?: string;
	image: string;
	qty?: string;
	unit?: number;
}

interface Props {
	product: Product;
	variant?: "default" | "recommended";
	modalId?: string;
	isFromCart?: boolean;
	showAddToCart?: boolean;
	/** Set on dark product-card contexts (e.g. the Explore/Sexual Health rails) so the
	 * Learn More/Get Started buttons flip to their light-on-dark variants instead of
	 * disappearing into the card's own dark background. */
	onDark?: boolean;
}

const {
	product,
	variant = "default",
	modalId,
	isFromCart = false,
	showAddToCart = false,
	onDark = false,
} = Astro.props;
const isRecommended = variant === "recommended";
const outlineClass = onDark ? "theme-btn__outline--white" : "theme-btn__outline";
const primaryClass = onDark ? "theme-btn__primary--alt" : "theme-btn__primary";
---

<div class:list={["product-card", { "product-card__alt": isRecommended }]}>
	<div class="product-card-media">
		{
			product.qty && (
				<span class="product-card-badge">
					<span class="product-card-badge-dot" aria-hidden="true" />
					{product.qty}
				</span>
			)
		}
		<img
			src={product.image}
			alt={product.name}
			class="product-card-image"
			loading="lazy"
		/>
	</div>
	<div class="product-card-body">
		<h3 class="product-card-title">{product.name}</h3>
		<p class="product-card-desc">{product.desc}</p>
		<div class="product-card-price">
			<span class="product-card-price-label">{product.priceLabel}</span>
			<span class="product-card-price-value">{product.price}</span>
		</div>
		<div class="product-card-actions">
			{
				isRecommended ? (
					<>
						{isFromCart ? (
							<>
								<span
									class="theme-btn theme-btn__primary"
									data-cart-add
									data-cart-name={product.name}
									data-cart-unit={product.unit}
								>
									Add to Cart
								</span>
								<a
									href="index.html#programs"
									class="theme-btn theme-btn__outline"
								>
									Learn More
								</a>
							</>
						) : (
							<>
								<a
									href="index.html#programs"
									class="theme-btn theme-btn__outline"
								>
									Learn More
								</a>
								<span
									class="theme-btn theme-btn__primary"
									data-cart-add
									data-cart-name={product.name}
									data-cart-unit={product.unit}
								>
									Add to Cart
								</span>
							</>
						)}
					</>
				) : (
					<>
						{modalId ? (
							<button
								type="button"
								class:list={["theme-btn", outlineClass]}
								data-modal-open={modalId}
							>
								Learn More
							</button>
						) : (
							<a href="#" class:list={["theme-btn", outlineClass]}>
								Learn More
							</a>
						)}
						{showAddToCart ? (
							<span
								class:list={["theme-btn", primaryClass]}
								data-cart-add
								data-cart-name={product.name}
								data-cart-unit={product.unit ?? 0}
							>
								Add to Cart
							</span>
						) : (
							<a href="index.html#cta" class:list={["theme-btn", primaryClass]}>
								Get Started
							</a>
						)}
					</>
				)
			}
		</div>
	</div>
</div>
