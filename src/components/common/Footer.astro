---
interface Props {
	/** Relative prefix back to the site root, for pages nested one or more levels deep (e.g. "../"). */
	base?: string;
}

const { base = "" } = Astro.props;
---

<div class="footer">
	<span class="footer-glow"></span>
	<div class="footer-inner">
		<div class="footer-grid">
			<div class="footer-brand">
				<a href="#top" class="footer-logo-link">
					<img
						src={`${base}Themes/Thrivewellrx.Theme.SlimoutV2/assets/img/logo-alt.svg`}
						alt="SlimOut"
						class="footer-logo"
					/>
				</a>
				<p class="footer-tagline"
					>Personalized telehealth care, from consultation to delivery.</p
				>
			</div>
			<div class="footer-col">
				<div class="footer-col-title">Explore</div>
				<div class="footer-links">
					<a href="#programs" class="footer-link">Treatments</a>
					<a href={`${base}about.html`} class="footer-link">About Us</a>
					<a href={`${base}login.html`} class="footer-link">Log In</a>
				</div>
			</div>
			<div class="footer-col">
				<div class="footer-col-title">Contact</div>
				<div class="footer-links">
					<a href="tel:8336543553" class="footer-link">(833) 654-3553</a>
					<a href="mailto:info@slimout.com" class="footer-link"
						>info@slimout.com</a
					>
				</div>
			</div>
		</div>
		<div class="footer-bottom">
			<span>&copy; 2026 | SLIMOUT | ALL RIGHTS RESERVED</span>
		</div>
	</div>
</div>
