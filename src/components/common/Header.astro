---
import { categories } from "../../data/categories";

interface Props {
	/** Relative prefix back to the site root, for pages nested one or more levels deep (e.g. "../"). */
	base?: string;
	/**
	 * "transparent" is a homepage-only treatment: a full-width bar sitting directly over the
	 * hero (no floating pill/gap), starting fully transparent with a white wordmark, then
	 * fading in a blurred dark bg + shadow once the page scrolls (see [data-header-scroll] in
	 * common.js). Every other page keeps the default floating cream pill.
	 */
	variant?: "default" | "transparent";
}

const { base = "", variant = "default" } = Astro.props;
---

<div class="header-scrollbar">
	<div id="scroll-bar" class="header-scrollbar-fill"></div>
</div>

<div
	class:list={["header", variant === "transparent" && "header--transparent"]}
	data-header-scroll={variant === "transparent" ? "" : undefined}
>
	<a href="#top" class="header-logo">
		<svg width="105" height="38" viewBox="0 0 138.405 50.513" fill="none" aria-label="Slimout">
			<path d="M 34.923 43.417 L 34.923 17.379 L 40.585 17.379 L 40.585 43.417 L 34.923 43.417 Z" fill="currentColor" fill-rule="evenodd"></path>
			<path d="M 44.582 22.12 L 44.582 17.379 L 50.244 17.379 L 50.244 22.12 L 44.582 22.12 Z M 44.582 43.417 L 44.582 24.374 L 50.244 24.374 L 50.244 43.417 L 44.582 43.417 Z" fill="currentColor" fill-rule="evenodd"></path>
